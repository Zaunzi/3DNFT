{
  "name": "cloudacre",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "tsc -p app/tsconfig.json && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test app/test/*.test.ts",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "contracts:deploy": "node scripts/deploy-contracts.mjs",
    "oil:deploy": "node scripts/deploy-oil.mjs",
    "legacy:dev": "vite dev --host 127.0.0.1 --port 3000",
    "legacy:build": "vite build",
    "world:test": "node --experimental-strip-types --test app/test/*.test.ts",
    "world:check": "tsc -p app/tsconfig.json",
    "world:contracts:test": "forge test --root contracts",
    "legacy:test": "node --test tests/*.test.mjs",
    "legacy:preview": "vite preview --host 127.0.0.1",
    "world:integration": "forge build --root contracts && node --experimental-strip-types app/test/onchain.integration.ts && node --experimental-strip-types app/test/nfts.integration.ts",
    "world:nfts:integration": "forge build --root contracts && node --experimental-strip-types app/test/nfts.integration.ts",
    "dev:mock": "node scripts/dev-atlas-mock.mjs",
    "world:fresh:compile": "node scripts/compile-atlas-v2.mjs",
    "world:fresh:integration": "npm run world:fresh:compile && node --experimental-strip-types app/test/fresh-suite.integration.ts"
  },
  "dependencies": {
    "@lucide/svelte": "0.562.0",
    "@reown/appkit": "1.8.15",
    "@reown/appkit-adapter-ethers": "1.8.15",
    "ethers": "6.16.0",
    "three": "0.185.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@pythnetwork/entropy-sdk-solidity": "^2.2.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.49.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "22.19.19",
    "@types/three": "0.185.4",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "svelte": "5.46.0",
    "svelte-check": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
