  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@pythnetwork/entropy-sdk-solidity": "^2.2.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.49.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "22.19.19",
    "@types/three": "0.185.4",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "svelte": "5.46.0",
