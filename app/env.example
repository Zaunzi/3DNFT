# Copy to app/.env.local. Defaults need no deployment or wallet extension.
VITE_WORLD_STATE_MODE=mock
VITE_MOCK_OWNER_ADDRESS=0x1111111111111111111111111111111111111111
VITE_MOCK_OWNED_PARCELS=742,743,744

# For onchain mode:
# VITE_WORLD_STATE_MODE=onchain
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_WORLD_PARCEL_NFT_ADDRESS=0x...
# VITE_PARCEL_STATE_ADDRESS=0x...
# Old VITE_WORLD_RPC_URL / VITE_WORLD_ADDRESS / VITE_WORLD_CHAIN_ID aliases
# remain supported. Without a state address, onchain mode stays read-only.
# Optional item/portal deployment (configure all three together)
VITE_ATLAS_ITEMS_ADDRESS=
VITE_WORLD_ITEM_STATE_ADDRESS=
VITE_PORTAL_STATE_ADDRESS=
# Optional NFT/container deployment (both, bound to the same land/items)
VITE_WORLD_NFT_STATE_ADDRESS=
VITE_CONTAINER_ITEM_STATE_ADDRESS=
VITE_ATLAS_CHARACTERS_ADDRESS=
# HTTPS gateway; external SVG/HTML/animation URLs are never rendered
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Optional separate instrument collection and its custody contract
VITE_DOODVERSE_TRINKETS_ADDRESS=
VITE_WORLD_TRINKET_STATE_ADDRESS=
